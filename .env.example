# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA-example

# Ваш chat_id в Telegram (узнать: @userinfobot, либо оставить 0 —
# бот сам покажет chat_id в ответ на /start)
TELEGRAM_CHAT_ID=0

# Client key из админки grok2api (раздел Client Keys, начинается с g2a_...)
GROK2API_KEY=g2a_example
